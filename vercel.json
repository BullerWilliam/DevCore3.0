{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "node -e \"console.log('Skipping root install; scripts/build-vercel-output.mjs handles workspace installs.')\"",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/vercel",
  "headers": [
    {
      "source": "/basic-api/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/v1/projects/frontpage",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/v1/devcore/profiles/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mystuff",
      "destination": "/mystuff/"
    },
    {
      "source": "/settings",
      "destination": "/settings/"
    },
    {
      "source": "/profile",
      "destination": "/profile/"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/"
    },
    {
      "source": "/credits",
      "destination": "/credits/"
    },
    {
      "source": "/contact",
      "destination": "/contact/"
    },
    {
      "source": "/terms",
      "destination": "/terms/"
    },
    {
      "source": "/signin",
      "destination": "/signin/"
    },
    {
      "source": "/signup",
      "destination": "/signup/"
    },
    {
      "source": "/forgotpassword",
      "destination": "/forgotpassword/"
    },
    {
      "source": "/support",
      "destination": "/support/"
    },
    {
      "source": "/dev-panel",
      "destination": "/dev-panel/"
    },
    {
      "source": "/docs",
      "destination": "/docs/"
    },
    {
      "source": "/extensions-gallery",
      "destination": "/extensions-gallery/"
    },
    {
      "source": "/guidelines/uploading",
      "destination": "/guidelines/uploading/"
    }
  ]
}
