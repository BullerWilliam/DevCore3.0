{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --workspaces=false --ignore-scripts --legacy-peer-deps",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/vercel",
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy/"
    },
    {
      "source": "/terms",
      "destination": "/terms/"
    },
    {
      "source": "/support",
      "destination": "/support/"
    },
    {
      "source": "/guidelines/uploading",
      "destination": "/guidelines/uploading/"
    }
  ]
}
